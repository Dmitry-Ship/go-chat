API_PORT=4000
CLIENT_ORIGIN=http://localhost:8080,http://localhost:3000

# Generate strong secrets with: make secret or use crypto/rand
ACCESS_TOKEN_SECRET="generate-with-make-secret-or-crypto-rand"
REFRESH_TOKEN_SECRET="generate-with-make-secret-or-crypto-rand"

# Use localhost when running backend on the host machine.
# Use postgres only when backend runs inside the same Docker network as Postgres.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=qwerty

REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password
# Use localhost when running backend on the host machine.
# Use redis only when backend runs inside the same Docker network as Redis.
REDIS_HOST=localhost

# WebSocket Rate Limiting
WS_RATE_LIMIT_MAX_USER=10
WS_RATE_LIMIT_MAX_IP=20
WS_RATE_LIMIT_WINDOW=60s
